# MADELARME — тестовая статическая сборка. Индексация запрещена (robots.txt + meta + заголовок ниже).
# Все директивы обёрнуты в IfModule и не требуют ничего сверх стандартного AllowOverride FileInfo.
# Заголовки безопасности действуют, только если файлы отдаёт Apache. На nginx/Caddy (Plesk) .htaccess игнорируется:
# те же заголовки нужно прописать в конфиге сервера (см. README.md, «Заголовки безопасности на хостинге»).
# Политика CSP: src/lib/security.ts (здесь же upgrade-insecure-requests: тестовый домен всегда на HTTPS).

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob:; connect-src 'self'; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "\.(mp4|webp|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_alias.c>
  # остатки Node-сборки и служебные файлы, если они лежат рядом, наружу не отдаём
  RedirectMatch 404 ^/(node_modules|\.next|\.cache)(/|$)
  RedirectMatch 404 ^/(server\.js|package\.json|\.env|README[^/]*\.md|.*\.service|nginx[^/]*\.conf)$
  # архивы сборки (site-*.zip и т.п.), если их забыли удалить из web-root
  RedirectMatch 404 (?i)\.(zip|tar|gz|tgz|7z|rar)$
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # /work → /work/ (папка с index.html)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>
