# Заявки с формы -> Telegram (Node-режим, src/app/api/lead/route.ts).
# Без них в продакшене /api/lead отвечает 503 и форма предлагает WhatsApp; при pnpm dev заявка пишется в консоль.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 1 - перед Node стоит свой прокси (nginx), который перезаписывает X-Real-IP. Иначе лимит заявок общий на весь сайт.
TRUST_PROXY=
# Канонический адрес сайта (canonical, og, sitemap, robots), без завершающего слэша. По умолчанию https://madelarme.kz
NEXT_PUBLIC_SITE_URL=https://madelarme.kz
# 1 - тестовый/превью домен: закрыть от индексации (robots, meta, X-Robots-Tag). Фиксируется при сборке.
NEXT_PUBLIC_NOINDEX=
# 1 - статический экспорт в out/ (scripts/package-static.sh ставит сам)
STATIC_EXPORT=
# 1 - статическая сборка без API: заявка уходит текстом в WhatsApp (ставить вместе с STATIC_EXPORT)
NEXT_PUBLIC_STATIC=
