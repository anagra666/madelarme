# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# demo media (regenerate with `pnpm media`)
/public/media/
/.cache/

# preview bundles
/dist/

# trailer render artifacts
/trailer/assets/
/trailer/frames/
/trailer/stills/
/trailer/*.mp4
/trailer/*.wav
/trailer/frames-h/
/trailer/stills-h/
/trailer/h/*
!/trailer/h/index.html
